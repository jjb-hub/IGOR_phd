# # ##### REMOVE EXCLUDED FROM PKL
# List of .pkl file paths to process
pkl_paths = [
    "/Users/jasminebutler/Desktop/IGOR_phd/PROJECTS/PSYCH_Ephys/cache/APP_df.pkl",
    "/Users/jasminebutler/Desktop/IGOR_phd/PROJECTS/PSYCH_Ephys/cache/FP_df.pkl",
    "/Users/jasminebutler/Desktop/IGOR_phd/PROJECTS/PSYCH_Ephys/cache/cell_df.pkl"
]

# Loop through each file, filter, and save a new version
for path_str in pkl_paths:
    path = Path(path_str)
    df = pd.read_pickle(path)

    if 'cell_id' not in df.columns:
        print(f"Skipping {path.name}: 'cell_id' column not found.")
        continue

    original_len = len(df)
    filtered_df = df[~df['cell_id'].isin(EXCLUDED)]
    removed_n = original_len - len(filtered_df)

    # Save to a new file with _filtered suffix
    new_path = path.with_name(f"{path.stem}_filtered{path.suffix}")
    filtered_df.to_pickle(new_path)
    print(f"Saved: {new_path.name} ({removed_n} rows removed)")


